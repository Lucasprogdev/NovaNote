<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Méthode d'export :
        development -> installable sur les appareils enregistrés (sideloading dev)
        ad-hoc      -> distribution interne sur appareils enregistrés
        app-store   -> App Store / TestFlight
      Adaptez selon votre besoin.
    -->
    <key>method</key>
    <string>development</string>

    <key>signingStyle</key>
    <string>manual</string>

    <key>teamID</key>
    <string>__TEAM_ID__</string>

    <key>compileBitcode</key>
    <false/>

    <key>stripSwiftSymbols</key>
    <true/>

    <key>uploadSymbols</key>
    <false/>
</dict>
</plist>
